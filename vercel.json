{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/workos.rsc", "destination": "https://work-os-peach.vercel.app/workos/index.rsc" },
    { "source": "/workos.segments/:path*", "destination": "https://work-os-peach.vercel.app/workos/index.segments/:path*" },
    { "source": "/workos", "destination": "https://work-os-peach.vercel.app/workos" },
    { "source": "/workos/:path*", "destination": "https://work-os-peach.vercel.app/workos/:path*" }
  ]
}
